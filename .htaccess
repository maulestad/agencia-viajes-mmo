# Seguridad básica (XAMPP y Docker)
Options -Indexes
DirectoryIndex index.php

<FilesMatch "(^\.|\.(sql|md|yml|yaml|sh|bat|log|example|gz|json)$)">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value memory_limit 256M
    php_value max_execution_time 300
</IfModule>
