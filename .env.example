# Copie este archivo como .env SOLO si necesita cambiar los valores por defecto.
# En XAMPP con la configuración estándar (root sin contraseña) NO hace falta .env.

APP_NAME="Agencia de Viajes"
APP_ENV=local
APP_DEBUG=1
APP_TIMEZONE=America/La_Paz

# --- MySQL (XAMPP / Docker) ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agencia_viajes
DB_USER=root
DB_PASS=

# --- PostgreSQL (Render) ---
# En Render basta con DATABASE_URL (se completa sola con render.yaml):
# DATABASE_URL=postgres://usuario:clave@host:5432/base
# DB_SSLMODE=require   # solo si conecta con la URL EXTERNA de Render

# Contraseña del usuario "admin" creada en la PRIMERA instalación
ADMIN_PASSWORD=admin123
# Cargar destinos/paquetes de ejemplo en la primera instalación (1/0)
SEED_DEMO=1
# Tamaño máximo de adjuntos (MB)
MAX_UPLOAD_MB=2
